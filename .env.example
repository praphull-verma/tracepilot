NODE_ENV=development

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database — local PostgreSQL (no Docker, no pgvector needed)
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/tracepilot

# AI Provider — Google Gemini (get key at https://aistudio.google.com)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Embedding — Gemini embedding model (no pgvector; uses float[] in Postgres)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Logging
LOG_LEVEL=info

# Upload
UPLOAD_MAX_SIZE_MB=25

# RAG top-K results
VECTOR_TOP_K=8
