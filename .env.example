NODE_ENV=development

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://tracepilot:tracepilot@localhost:5432/tracepilot

# AI Provider
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Demo Mode (uses mock AI when no API key is set)
DEMO_MODE=true

# Logging
LOG_LEVEL=info

# Upload
UPLOAD_MAX_SIZE_MB=25

# RAG
VECTOR_TOP_K=8
